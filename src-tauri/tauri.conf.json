{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Premiumflix",
  "version": "../package.json",
  "identifier": "me.premiumflix.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Premiumflix",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Entertainment",
    "shortDescription": "Netflix-style frontend for your Premiumize cloud storage",
    "longDescription": "Premiumflix turns your Premiumize.me cloud storage into a streaming service: it scans your folders, matches titles with TMDB, and streams them with subtitles, resume, and Trakt sync.",
    "copyright": "Copyright (c) 2026 Sanid Jusic"
  }
}
